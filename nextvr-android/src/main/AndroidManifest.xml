<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OpenGL ES 3.0 is required by the Cardboard SDK build (see sdk/build.gradle). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true"/>
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false"/>
    <!-- A single rear camera feeds passthrough and hand analysis. No microphone capture. -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The phone mirror is a MediaProjection capture, and Android 10+ refuses to construct one
         unless a foreground service of type "mediaProjection" is already running
         (MediaProjection.start() throws SecurityException otherwise). FOREGROUND_SERVICE is the base
         permission; the type-specific one is required from Android 14 on. The notification is not
         optional and is not hidden: it is the system's (and the user's) indication that the screen is
         being captured. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Only so that the capture notification can be shown on Android 13+; never requested at
         runtime, and capture works without it (the system hides the notification instead). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Shizuku's permission provider: the app asks Shizuku for the shell user service through it. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Package visibility (Android 11+). Two different needs, both explicit:
          * the launcher intent, so that the app library really lists the device's apps. Without this
            entry queryIntentActivities() silently returns only a handful of system-package
            exceptions on Android 11+ — a real-device-only failure (the emulator has too few apps to
            notice). It is the narrowest declaration that works: QUERY_ALL_PACKAGES is a
            Play-policy-gated permission and is deliberately not used.
          * the Shizuku packages, so the row can say "install Shizuku" instead of "not installed"
            forever. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.manager" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="rikka.shizuku" />

        <!-- PhoneXR. The runtime, its VrApi driver and the OpenXR broker are named directly because
             their exact package names are what the UI has to report on ("installed", "outdated") and
             a wrong answer there means a black screen with no explanation. The category queries are
             what find the games: a headset game says so in its manifest and there is no other way to
             ask, because neither PackageManager nor anything else reports which libraries it ships.
             Gear VR games declare MAIN + INFO instead of a launcher entry, so the categories have to
             be queried as well as the launcher. -->
        <package android:name="org.freedesktop.monado.openxr_runtime.out_of_process" />
        <package android:name="org.freedesktop.monado.openxr_runtime.in_process" />
        <package android:name="com.oculus.systemdriver" />
        <package android:name="org.khronos.openxr.runtime_broker" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.oculus.intent.category.VR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.google.intent.category.DAYDREAM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.google.intent.category.CARDBOARD" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/nextvr_ic_launcher"
        android:roundIcon="@drawable/nextvr_ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="com.nextvr.app.NextVrActivity"
            android:label="@string/title_activity_vr"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The no-Shizuku input path: gestures and global actions for the phone-mirror window.
             Inactive until the user enables it in Android's accessibility settings, and it only
             ever dispatches what the user did with their hand. -->
        <service
            android:name="com.nextvr.app.apps.NextVrAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nextvr_accessibility_service" />
        </service>

        <!-- The foreground service Android requires for a MediaProjection (see the permissions
             above). Not exported, no binder, started only while the mirror window is being opened. -->
        <service
            android:name="com.nextvr.app.apps.AppMirrorService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Shizuku's binder provider. The permission is the one Shizuku itself requires; the
             authority must be the application id plus ".shizuku". -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- The Shizuku provider library declares this meta-data in its own manifest as well; it is
             repeated here so the requirement stays visible in this repository (it is what makes an
             app built against an older Shizuku receive the binder instead of a refusal — without it
             pingBinder() stays false even with Shizuku running). The provider element above, unlike
             this meta-data, can only come from the app: the authority must be the application id. -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
    </application>
</manifest>
