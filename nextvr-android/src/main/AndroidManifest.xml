<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OpenGL ES 3.0 is required by the Cardboard SDK build (see sdk/build.gradle). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true"/>
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true"/>
    <!-- A single rear camera feeds passthrough and hand analysis. No microphone capture. -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Shizuku's permission provider: the app asks Shizuku for the shell user service through it. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Package visibility (Android 11+): the app windows feature has to see whether Shizuku is
         installed to explain what is missing, instead of reporting "not installed" forever. -->
    <queries>
        <package android:name="moe.shizuku.manager" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="rikka.shizuku" />
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/nextvr_ic_launcher"
        android:roundIcon="@drawable/nextvr_ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="com.nextvr.app.NextVrActivity"
            android:label="@string/title_activity_vr"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The no-Shizuku input path: gestures and global actions for the phone-mirror window.
             Inactive until the user enables it in Android's accessibility settings, and it only
             ever dispatches what the user did with their hand. -->
        <service
            android:name="com.nextvr.app.apps.NextVrAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nextvr_accessibility_service" />
        </service>

        <!-- Shizuku's binder provider. The permission is the one Shizuku itself requires; the
             authority must be the application id plus ".shizuku". -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- The Shizuku provider library declares this meta-data in its own manifest as well; it is
             repeated here so the requirement stays visible in this repository (it is what makes an
             app built against an older Shizuku receive the binder instead of a refusal — without it
             pingBinder() stays false even with Shizuku running). The provider element above, unlike
             this meta-data, can only come from the app: the authority must be the application id. -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
    </application>
</manifest>
