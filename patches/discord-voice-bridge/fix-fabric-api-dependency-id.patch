+name: Loader smoke test
+
+# Manual, end-to-end check of the *published* artifact: builds the release jar,
+# boots a real Fabric 26.3 dedicated server with only that jar (plus Simple
+# Voice Chat) in mods/, and fails if Fabric Loader cannot resolve its
+# dependencies.
+#
+# This is the reproduction for the "Mod 'Discord Voice Bridge' ...
+# requires version 0.165.0 or later of fabric, which is missing!" report.
+# Running it against the 1.0.0 jar fails; running it against a fixed jar must
+# reach "Done (" with fabric-api in the loaded mod list.
+#
+# It is manual (workflow_dispatch) on purpose: it downloads a Minecraft server
+# and boots it, which is slower and noisier than the normal CI build. Run it
+# before publishing a release, not on every push.
+
+on:
+  workflow_dispatch:
+
+jobs:
+  boot:
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Java 25
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: 25
+
+      - name: Fetch Simple Voice Chat from Modrinth
+        run: |
+          mkdir -p libs
+          curl -fL --retry 3 -o "libs/voicechat-fabric-2.6.27+26.3.jar" \
+            "https://cdn.modrinth.com/data/9eGKb6K1/versions/x9jLR94Q/voicechat-fabric-2.6.27%2B26.3.jar"
+
+      - name: Build
+        run: ./gradlew clean build --no-daemon
+
+      - name: Verify release jar metadata
+        run: python3 scripts/verify_release_jar.py build/libs/discord_voice_bridge-1.0.1.jar
+
+      - name: Prepare server
+        run: |
+          set -euo pipefail
+          mkdir -p server/mods
+          cp build/libs/discord_voice_bridge-1.0.1.jar server/mods/
+          cp libs/voicechat-fabric-2.6.27+26.3.jar server/mods/
+          cd server
+          echo "eula=true" > eula.txt
+          printf '%s\n' \
+            'online-mode=false' \
+            'level-type=minecraft\:flat' \
+            'spawn-protection=0' \
+            'max-tick-time=-1' \
+            'view-distance=4' \
+            'simulation-distance=4' > server.properties
+          INSTALLER=$(curl -fsSL https://meta.fabricmc.net/v2/versions/installer \
+            | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["version"])')
+          echo "Fabric installer: $INSTALLER"
+          curl -fsSL --retry 3 -o fabric-server.jar \
+            "https://meta.fabricmc.net/v2/versions/loader/26.3/0.20.1/${INSTALLER}/server/jar"
+          ls -la mods fabric-server.jar
+
+      - name: Boot server with only this mod installed
+        run: |
+          set -uo pipefail
+          cd server
+          java -Xmx2G -jar fabric-server.jar nogui > server.log 2>&1 &
+          SERVER_PID=$!
+
+          for _ in $(seq 1 150); do
+            if grep -q 'Done (' server.log 2>/dev/null; then break; fi
+            if grep -qE 'which is missing!|A potential solution|ModResolutionException' server.log 2>/dev/null; then break; fi
+            if ! kill -0 "$SERVER_PID" 2>/dev/null; then break; fi
+            sleep 2
+          done
+
+          kill "$SERVER_PID" 2>/dev/null || true
+          wait "$SERVER_PID" 2>/dev/null || true
+
+          echo '===== server.log ====='
+          cat server.log
+          echo '======================'
+          echo '===== mod list ====='
+          grep -iE "Loading [0-9]+ mods|fabric-api|discord_voice_bridge" server.log || true
+
+          status=0
+          if grep -q 'which is missing!' server.log; then
+            echo "::error::Fabric Loader could not resolve a dependency of the release jar."
+            status=1
+          fi
+          if ! grep -q 'Done (' server.log; then
+            echo "::error::Server did not finish starting."
+            status=1
+          fi
+          if ! grep -q 'fabric-api' server.log; then
+            echo "::error::The nested Fabric API did not load; the jar is not self-contained."
+            status=1
+          fi
+          exit $status
+
+      - name: Upload server log
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: loader-smoke-server-log
+          path: server/server.log
